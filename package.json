{
  "name": "postly",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint:boundaries": "depcruise src --config .dependency-cruiser.mjs",
    "test": "vitest run",
    "test:e2e": "vitest run --project e2e",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint:boundaries && npm run test",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "playwright": "^1.64.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@swc/core": "1.16.21",
    "@types/node": "^26.6.6",
    "dependency-cruiser": "18.7.2",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  },
  "allowScripts": {
    "esbuild": true,
    "@swc/core": true
  }
}
