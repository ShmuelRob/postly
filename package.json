{
  "name": "postly",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p playground/web",
    "build": "tsc -p tsconfig.build.json",
    "lint:links": "node scripts/check-links.ts",
    "lint:boundaries": "depcruise src playground --config .dependency-cruiser.mjs",
    "test": "vitest run",
    "test:e2e": "vitest run --project e2e --project e2e-browser",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint:links && npm run lint:boundaries && npm run test",
    "gallery": "vitest run --config vitest.gallery.config.ts",
    "db:generate": "drizzle-kit generate",
    "playground": "vite --config playground/vite.config.ts"
  },
  "dependencies": {
    "@hebcal/core": "^6.14.7",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "pg-boss": "^12.38.0",
    "playwright": "^1.64.1",
    "postgres": "^3.4.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@swc/core": "1.16.21",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "dependency-cruiser": "18.7.2",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  },
  "allowScripts": {
    "esbuild": true,
    "@swc/core": true
  }
}
