# Only what the Dockerfile's two targets copy goes into the build context. The product target
# (`runtime`) never copies playground/ or test/; only the `sandbox` target does.
**
!package.json
!package-lock.json
!tsconfig.json
!tsconfig.build.json
!tsconfig.sandbox.json
!src/**
!assets/**
!drizzle/**
!playground/**
!test/e2e/harness/record.ts
# Tests and fixtures never enter an image.
src/**/*.test.ts
src/**/*.test.tsx
src/**/__snapshots__/**
playground/**/*.test.ts
