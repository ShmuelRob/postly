# syntax=docker/dockerfile:1.7
# The dev sandbox (WP-51, docs/deployment.md "The sandbox"): the playground's chat, mock feed and mock
# checkout for the deployed dev on the simulators. Its own image, built by the deploy workflow only for
# dev; the product image (Dockerfile) never holds playground code. Build context rules:
# Dockerfile.sandbox.dockerignore.

ARG NODE_VERSION=26

FROM node:${NODE_VERSION}-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts=false
COPY tsconfig.json tsconfig.build.json tsconfig.sandbox.json ./
COPY src ./src
COPY playground ./playground
# Types only: the sandbox's e2e report helpers name the report's record types.
COPY test/e2e/harness/record.ts ./test/e2e/harness/record.ts
RUN npx tsc -p tsconfig.sandbox.json && npx vite build --config playground/sandbox/vite.config.ts

FROM node:${NODE_VERSION}-bookworm-slim AS deps
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force

# The design renderer is created but never renders here (the sandbox only signs up), so no Chromium.
FROM node:${NODE_VERSION}-bookworm-slim AS runtime
ENV NODE_ENV=production PORT=8080
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY package.json ./
COPY --from=build /app/dist ./dist
COPY assets ./dist/assets
USER node
EXPOSE 8080
ENTRYPOINT ["node", "--enable-source-maps", "dist/playground/sandbox/main.js"]
